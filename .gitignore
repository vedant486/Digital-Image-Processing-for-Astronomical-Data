# Large/raw astronomical data
# Keep raw FITS out of Git by default; document download instructions instead.
data/raw/*
!data/raw/.gitkeep

data/processed/*
!data/processed/.gitkeep

# Generated results
results/figures/*
!results/figures/.gitkeep
